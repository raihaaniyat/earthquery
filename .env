# SatQuery AI Local Development Configuration

# 1. Database Connections
DATABASE_URL=postgresql+psycopg://satquery_admin:satquery_admin_password@127.0.0.1:5432/satquery
CHECKPOINT_DATABASE_DSN=postgresql://satquery_admin:satquery_admin_password@127.0.0.1:5432/satquery

# 2. Redis & Queue Configuration
REDIS_URL=redis://:satquery_redis_password@127.0.0.1:6379/0
REDIS_QUEUE_INGEST=satquery-ingest
REDIS_QUEUE_ANALYSIS=satquery-analysis

# 3. Object Storage (S3 / SeaweedFS / MinIO)
S3_ENDPOINT_INTERNAL=http://127.0.0.1:8333
S3_ENDPOINT_PUBLIC=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=satquery_s3_admin
S3_SECRET_ACCESS_KEY=satquery_s3_secret_key
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_BUCKET_INPUTS=satquery-inputs
S3_BUCKET_DERIVED=satquery-derived
S3_BUCKET_MODELS=satquery-models
S3_BUCKET_DATASETS=satquery-datasets

# 4. Storage & Execution Paths
SATQUERY_DATA_ROOT=C:/Users/HP/earthquery/data
SATQUERY_CACHE_ROOT=C:/Users/HP/earthquery/cache
SATQUERY_MODEL_ROOT=C:/Users/HP/earthquery/models
SATQUERY_STORAGE_ROOT=C:/Users/HP/earthquery/storage

# 5. Conda Python Interpreters & Environments
SATQUERY_CONDA_EXE=C:/Users/HP/miniconda3/Scripts/conda.exe
CORE_ENV=satquery-core
CHANGEFORMER_ENV=satquery-changeformer
GEOGROUND_ENV=satquery-geoground
API_ENV=satquery-api

# 6. Concurrency & Resource Budgets
GPU_CONCURRENCY=1
CPU_CONCURRENCY=1
GPU_MIN_FREE_MIB=512
MAX_VRAM_GB=7.5
MAX_QUEUED_GPU_JOBS=10
MAX_UPLOAD_BYTES=524288000
MIN_FREE_DISK_BYTES=10737418240
MAX_VQA_TILES=6
MAX_VQA_TOKENS=512

# 7. Security, CORS & Compatibility
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
AUTH_MODE=local_bearer
CUDNN_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8000
